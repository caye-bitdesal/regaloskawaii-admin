{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "regaloskawaii-admin",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"routes": [
		{
			"pattern": "admin.regaloskawaii.es",
			"custom_domain": true
		},
	],
	"vars": {
		"EMDASH_SITE_URL": "https://admin.regaloskawaii.es",
	},
	// No cambiar estos nombres: un nombre nuevo crea una base de datos / bucket vacíos.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "regaloskawaii",
			"database_id": "2e0c8267-d652-4fec-8a0d-ab8e49a14734",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "regaloskawaii-media",
		},
		{
			"bucket_name": "regaloskawaii-media",
			"binding": "regaloskawaii_media"
		},
	],
	// Plugins aislados: solo en Workers Paid. Se deja desactivado (plan gratuito).
	// "worker_loaders": [{ "binding": "LOADER" }],
	// Cron de mantenimiento cada 15 min (debe coincidir con generalCron en src/worker.ts)
	"triggers": {
		"crons": [
			"*/15 * * * *"
		],
	},
}