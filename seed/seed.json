{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"defaultLocale": "es",
	"meta": {
		"name": "Regalos Kawaii",
		"description": "Catálogo de regalos kawaii con enlaces de afiliado",
		"author": "Bitdesal"
	},
	"settings": {
		"title": "Regalos Kawaii",
		"tagline": "Regalos kawaii bonitos, originales y al mejor precio",
		"timezone": "Europe/Madrid"
	},
	"collections": [
		{
			"slug": "productos",
			"label": "Productos",
			"labelSingular": "Producto",
			"description": "Productos del catálogo con su enlace de afiliado",
			"icon": "gift",
			"sortOrder": 1,
			"urlPattern": "/producto/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"search",
				"seo"
			],
			"titleField": "title",
			"admin": {
				"listColumns": [
					"id_externo",
					"precio_ref",
					"tipo",
					"destacado"
				]
			},
			"fields": [
				{
					"slug": "title",
					"label": "Nombre",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "resumen",
					"label": "Resumen (1–2 frases para la tarjeta)",
					"type": "text",
					"searchable": true,
					"validation": {
						"maxLength": 200
					}
				},
				{
					"slug": "descripcion",
					"label": "Descripción (texto propio, no copiar el de la tienda)",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "tienda",
					"label": "Tienda",
					"type": "reference",
					"required": true,
					"validation": {
						"targetCollection": "tiendas"
					}
				},
				{
					"slug": "id_externo",
					"label": "ID en la tienda (ASIN en Amazon)",
					"type": "string",
					"required": true,
					"indexed": true,
					"validation": {
						"maxLength": 40
					}
				},
				{
					"slug": "enlace_afiliado",
					"label": "Enlace de afiliado (opcional: si está vacío se usa la plantilla de la tienda)",
					"type": "url"
				},
				{
					"slug": "precio_ref",
					"label": "Precio de referencia (€)",
					"type": "number",
					"validation": {
						"min": 0
					}
				},
				{
					"slug": "precio_actualizado",
					"label": "Precio comprobado el",
					"type": "datetime"
				},
				{
					"slug": "imagen",
					"label": "Imagen principal",
					"type": "image"
				},
				{
					"slug": "galeria",
					"label": "Más imágenes",
					"type": "repeater",
					"validation": {
						"maxItems": 8,
						"subFields": [
							{
								"slug": "imagen",
								"label": "Imagen",
								"type": "image",
								"required": true
							}
						]
					}
				},
				{
					"slug": "fuente_imagen",
					"label": "Origen de las imágenes",
					"type": "select",
					"defaultValue": "propia",
					"validation": {
						"options": [
							"propia",
							"marca"
						]
					}
				},
				{
					"slug": "tipo",
					"label": "Tipo",
					"type": "select",
					"required": true,
					"indexed": true,
					"defaultValue": "generico",
					"validation": {
						"options": [
							"oficial",
							"generico"
						]
					}
				},
				{
					"slug": "edad_min",
					"label": "Edad mínima recomendada",
					"type": "integer",
					"indexed": true,
					"validation": {
						"min": 0,
						"max": 99
					}
				},
				{
					"slug": "colecciones",
					"label": "Colecciones",
					"type": "reference",
					"validation": {
						"targetCollection": "colecciones",
						"multiple": true
					}
				},
				{
					"slug": "destacado",
					"label": "Destacado en portada",
					"type": "boolean",
					"indexed": true,
					"defaultValue": false
				},
				{
					"slug": "para_grabar",
